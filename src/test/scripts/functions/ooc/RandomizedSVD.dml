# Two-pass randomized SVD (Halko et al.). The contrast to the exact pca/eigen
# path is that the data is touched exactly twice: once to build the sketch and
# once to project. Orthonormalization goes through the k-by-k Gram matrix so
# that no pass has to materialize the tall factor.

X = read($1);
k = as.integer($2);
seed = as.integer($3);

Omega = rand(rows=ncol(X), cols=k, pdf="normal", seed=seed);

Y = X %*% Omega;               # pass 1: m-by-k sketch
G = t(Y) %*% Y;                # k-by-k Gram (tsmm)
L = cholesky(G);               # G = L %*% t(L), so Y = Q %*% t(L)
Q = Y %*% t(inv(L));           # m-by-k orthonormal basis
B = t(Q) %*% X;                # pass 2: k-by-n projection

[U0, S, V] = svd(B);
U = Q %*% U0;

write(S, $4, format="binary");
write(V, $5, format="binary");
print("nnzU=" + sum(U != 0));
