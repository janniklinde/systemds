# removeEmpty is the only operator here whose output row count is data
# dependent, so every downstream operator starts from an unknown dimension
# that has to be carried through: t() -> n-ary min, rowSums -> broadcast
# multiply, and finally a tsmm.
#
# The select vector is derived from the data rather than read: reading it
# would expose its number of non-zeros through the metadata, and the compiler
# infers the compacted row count from exactly that.

X = read($1);
sel = rowSums(X) > (ncol(X) / 2);

R = removeEmpty(target=X, margin="rows", select=sel);
Rt = t(R);
M = min(Rt, Rt+1, Rt+2);
v = rowSums(R);
Z = R * v;
G = t(Z) %*% Z;
S = G + sum(M);

write(S, $2, format="binary");
