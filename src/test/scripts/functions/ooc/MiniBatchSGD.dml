# Mini-batch SGD logistic regression. Unlike the batch solvers, this touches X
# through sequential row ranges rather than full scans, which is the access
# pattern of the neural-network training loops (nn/ffTrain, autoencoder).
# Batches are deterministic row ranges so OOC and CP results are comparable.

X = read($1);
y = read($2);
epochs = as.integer($3);
batch = as.integer($4);
lr = as.double($5);

n = nrow(X);
d = ncol(X);
w = matrix(0, rows=d, cols=1);
iters = ceil(n / batch);

for(e in 1:epochs) {
  for(i in 1:iters) {
    beg = (i-1) * batch + 1;
    end = min(n, beg + batch - 1);
    Xb = X[beg:end,];
    yb = y[beg:end,];
    p = 1 / (1 + exp(-(Xb %*% w)));
    g = t(Xb) %*% (p - yb) / (end - beg + 1);
    w = w - lr * g;
  }
}

write(w, $6, format="binary");
