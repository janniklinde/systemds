# Exercises the reorg operators that have no block-local CP shortcut in an OOC
# plan: rev over a streamed matrix, diag on a streamed vector (diagV2M) and diag
# on the resulting streamed square matrix (diagM2V).

X = read($1);
v = read($2);

R = rev(X);          # row reversal, block re-alignment if nrow(X) % blocksize != 0
D = diag(v);         # diagV2M
d = diag(D);         # diagM2V over a streamed square matrix
s = sum(D %*% v);    # keeps D in the stream instead of folding it away

write(R, $3, format="binary");
write(d, $4, format="binary");
write(s, $5);
