# Single-pass preprocessing baseline: column statistics plus the standardizing
# rewrite of the data. Reads X once for the statistics and once for the output,
# so it is the closest thing to a pure-IO roofline among these scripts.

X = read($1);

[Xs, cmean, csd] = scale(X=X, center=TRUE, scale=TRUE);

write(cmean, $2, format="binary");
write(csd, $3, format="binary");
print("sumXs=" + sum(Xs));
