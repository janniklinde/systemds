X = rand(rows = 1201, cols = 1103, seed = 7)

C = rand(rows = 7, cols = 1103, seed = 13)
D = -2 * (X %*% t(C)) + t(rowSums(C ^ 2))
P = D <= rowMins(D)
P = P / rowSums(P)
C = (t(P) %*% X) / t(colSums(P))

W = rand(rows = 1201, cols = 7, seed = 17)
H = rand(rows = 7, cols = 1103, seed = 19)
for(i in 1:2) {
	H = H * ((t(W) %*% X) / (((t(W) %*% W) %*% H) + 1e-9))
	W = W * ((X %*% t(H)) / ((W %*% (H %*% t(H))) + 1e-9))
}

write(C, $1, format = "binary")
write(W, $2, format = "binary")
write(H, $3, format = "binary")
