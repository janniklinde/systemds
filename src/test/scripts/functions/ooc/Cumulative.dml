X = read($1);

S = cumsum(X);
P = cumprod(X);
L = cummin(X);
G = cummax(X);
Q = S + colSums(S);

write(S, $2, format="binary");
write(P, $3, format="binary");
write(L, $4, format="binary");
write(G, $5, format="binary");
write(Q, $6, format="binary");
