# Multinomial naive Bayes written directly as sufficient statistics, instead of
# through the builtin. The builtin routes the per-class reduction through
# aggregate(target, groups), which has no out-of-core counterpart; expressing
# the same reduction as t(onehot(Y)) %*% X keeps it a single streaming pass.

X = read($1);
Y = read($2);
laplace = as.double($3);

n = nrow(X);
d = ncol(X);
k = as.integer(max(Y));

Yoh = table(seq(1, n), Y, n, k);          # n-by-k one-hot labels
classFeatureCounts = t(Yoh) %*% X;        # k-by-d, the single pass over X
classCounts = t(colSums(Yoh));            # k-by-1

prior = classCounts / n;
classConditionals = (classFeatureCounts + laplace) /
  (rowSums(classFeatureCounts) + laplace * d);

write(prior, $4, format="binary");
write(classConditionals, $5, format="binary");
