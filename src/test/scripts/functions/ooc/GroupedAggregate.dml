X = read($1);
G = read($2);

S = aggregate(target=X, groups=G, fn="sum", ngroups=$3);
C = aggregate(target=G, groups=G, fn="count", ngroups=$3);
M = aggregate(target=X, groups=G, fn="mean", ngroups=$3);
V = aggregate(target=X, groups=G, fn="variance", ngroups=$3);
L = aggregate(target=X, groups=G, fn="min", ngroups=$3);
H = aggregate(target=X, groups=G, fn="max", ngroups=$3);

write(S, $4, format="binary");
write(C, $5, format="binary");
write(M, $6, format="binary");
write(V, $7, format="binary");
write(L, $8, format="binary");
write(H, $9, format="binary");
