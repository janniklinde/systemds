W_v_agg = as_fp32(read($1));
W_v_in = as_fp32(read($2));
W_c_agg = as_fp32(read($3));
W_c_in = as_fp32(read($4));
b_v = as_fp32(read($5));
b_c = as_fp32(read($6));
W_v_vccv = as_fp32(read($7));
W_c_vccv = as_fp32(read($8));
W_e_vccv = as_fp32(read($9));
b_vccv = as_fp32(read($10));
v = as_fp32(read($11));
c = as_fp32(read($12));
e = as_fp32(read($13));
Ex2 = as_fp32(read($14));

print("START");
for(i in 1:30) {
[v_act, c_act] = message_passing_bipartite(
  W_v=W_v_agg, W_c=W_c_agg, b_v=b_v, b_c=b_c,
  W_v_vccv=W_v_vccv, W_c_vccv=W_c_vccv, W_e_vccv=W_e_vccv, b_vccv=b_vccv,
  v=v, c=c, e=e, Ex2=Ex2
);
v_out = pmax(v_act, 0) %*% t(v_act) + v_act;
  print(v_out[1, 1]);
  print(c_act[1, 1]);
}
