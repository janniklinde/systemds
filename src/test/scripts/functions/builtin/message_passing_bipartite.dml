V = matrix("1 0 0 1", 2, 2);
C = matrix("1 0 0 1", 2, 2);
E = matrix("1 0 0 1", 2, 2);

W_v_vccv = matrix("1 0 0 1", 2, 2);
W_c_vccv = matrix("1 0 0 1", 2, 2);
W_e_vccv = matrix("1 0 0 1", 2, 2);
b_vccv = matrix("0 0", 1, 2);

v = matrix("1 2 3 4", 2, 2);
c = matrix("1 1 1 1", 2, 2);
e = matrix("2 0 0 2", 2, 2);

[v_out, c_out, v_act, c_act] = message_passing_bipartite(
  V=V, C=C, E=E,
  W_v_vccv=W_v_vccv, W_c_vccv=W_c_vccv, W_e_vccv=W_e_vccv, b_vccv=b_vccv,
  v=v, c=c, e=e
);
