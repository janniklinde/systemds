V = matrix("1 0 0 1", 2, 2);
C = matrix("1 0 0 1", 2, 2);
E = matrix("1 0 0 1", 2, 2);

W_v_vc = matrix("1 0 0 1", 2, 2);
W_c_vc = matrix("1 0 0 1", 2, 2);
W_e_vc = matrix("1 0 0 1", 2, 2);
b_vc = matrix("0 0", 1, 2);

W_v_cv = matrix("1 0 0 1", 2, 2);
W_c_cv = matrix("1 0 0 1", 2, 2);
b_cv = matrix("0 0", 1, 2);

W_v = matrix("1 0 0 1", 2, 2);
b_v = matrix("0 0", 1, 2);
W_c = matrix("1 0 0 1", 2, 2);
b_c = matrix("0 0", 1, 2);

v = matrix("1 2 3 4", 2, 2);
c = matrix("1 1 1 1", 2, 2);
e = matrix("2 0 0 2", 2, 2);

[v_out, c_out, v_act, c_act] = message_passing_bipartite(
  V=V, C=C, E=E,
  W_v_vc=W_v_vc, W_c_vc=W_c_vc, W_e_vc=W_e_vc, b_vc=b_vc,
  W_v_cv=W_v_cv, W_c_cv=W_c_cv, b_cv=b_cv,
  W_v=W_v, b_v=b_v, W_c=W_c, b_c=b_c,
  v=v, c=c, e=e
);
