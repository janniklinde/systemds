# Dataset paths (SystemDS format).
data_dir = "gnn_examples/examples/systemds/case13659pegase-2017-09-02";

# Node features contain concatenated variables + constraints.
node_features = read(data_dir + "/node_features");
edge_index_raw = read(data_dir + "/edge_index");
edge_features = read(data_dir + "/edge_features");

print("node_features: " + nrow(node_features) + "x" + ncol(node_features));
print("edge_index_raw: " + nrow(edge_index_raw) + "x" + ncol(edge_index_raw));
print("edge_features: " + nrow(edge_features) + "x" + ncol(edge_features));

print(nrow(edge_features) + "x" + ncol(edge_features));

# edge_index is stored as 2 x E; transpose to E x 2 and fix indexing if needed.
edge_index = edge_index_raw;
if (nrow(edge_index_raw) == 2) {
  edge_index = t(edge_index_raw);
}
if (ncol(edge_index) < 2) {
  stop("edge_index has fewer than 2 columns after transpose check.");
}
min_idx = min(edge_index);
if (min_idx == 0) {
  edge_index = edge_index + 1;
}

# Split node_features into variables and constraints.
# edge_index is [v_idx, c_idx] with c_idx offset by Nvars.
Nvars = as.integer(max(edge_index[, 1]));
variable_features = node_features[1:Nvars, ];
constraint_features = node_features[(Nvars+1):nrow(node_features), ];

# Swap to [c_idx, v_idx] and rebase constraints to 1..Ncons.
edge_index = cbind(edge_index[,2], edge_index[,1]);
edge_index[, 1] = edge_index[, 1] - Nvars;

Ncons = nrow(constraint_features);
Nvars = nrow(variable_features);
E = nrow(edge_index);
Dc = ncol(constraint_features);
Dv = ncol(variable_features);
Fe = ncol(edge_features);

# Replace features with random 32-dim embeddings (for testing).
embd = 32;
variable_features = rand(rows=Nvars, cols=embd, min=-0.1, max=0.1, sparsity=1.0, seed=101);
constraint_features = rand(rows=Ncons, cols=embd, min=-0.1, max=0.1, sparsity=1.0, seed=102);
Dv = embd;
Dc = embd;

# Sort edges by constraint index, then variable index.
by_cols = matrix("1 2", rows=1, cols=2);
edge_all = cbind(edge_index, edge_features);
edge_all = order(target=edge_all, by=by_cols, decreasing=FALSE, index.return=FALSE);
edge_index = edge_all[, 1:2];
edge_features = edge_all[, 3:ncol(edge_all)];

# Inference step: random weight init and fused message passing.
d = min(Dv, Dc);
W_v_agg = rand(rows=d, cols=d, min=-0.1, max=0.1, sparsity=1.0, seed=1);
W_v_in = rand(rows=d, cols=d, min=-0.1, max=0.1, sparsity=1.0, seed=2);
W_c_agg = rand(rows=d, cols=d, min=-0.1, max=0.1, sparsity=1.0, seed=3);
W_c_in = rand(rows=d, cols=d, min=-0.1, max=0.1, sparsity=1.0, seed=4);
b_v = rand(rows=1, cols=d, min=-0.1, max=0.1, sparsity=1.0, seed=5);
b_c = rand(rows=1, cols=d, min=-0.1, max=0.1, sparsity=1.0, seed=6);
W_v_vccv = rand(rows=Dv, cols=2*d, min=-0.1, max=0.1, sparsity=1.0, seed=5);
W_c_vccv = rand(rows=Dc, cols=2*d, min=-0.1, max=0.1, sparsity=1.0, seed=6);
W_e_vccv = rand(rows=Fe, cols=2*d, min=-0.1, max=0.1, sparsity=1.0, seed=7);
b_vccv = rand(rows=1, cols=2*d, min=-0.1, max=0.1, sparsity=1.0, seed=8);
d = as.integer(ncol(W_v_vccv) / 2);

W_v_agg = as_fp32(W_v_agg);
W_v_in = as_fp32(W_v_in);
W_c_agg = as_fp32(W_c_agg);
W_c_in = as_fp32(W_c_in);
b_v = as_fp32(b_v);
b_c = as_fp32(b_c);
W_v_vccv = as_fp32(W_v_vccv);
W_c_vccv = as_fp32(W_c_vccv);
W_e_vccv = as_fp32(W_e_vccv);
b_vccv = as_fp32(b_vccv);
variable_features = as_fp32(variable_features);
constraint_features = as_fp32(constraint_features);
edge_features = as_fp32(edge_features);
edge_index = as_fp32(edge_index);

v_act_list = list();
c_act_list = list();
v_out_list = list();
c_out_list = list();
v_in = variable_features;
c_in = constraint_features;
for(i in 1:10) {
  [t3, t4, t1, t2] = message_passing_bipartite(
    W_v=W_v_agg, W_c=W_c_agg, b_v=b_v, b_c=b_c,
    W_v_in=W_v_in, W_c_in=W_c_in,
    W_v_vccv=W_v_vccv, W_c_vccv=W_c_vccv, W_e_vccv=W_e_vccv, b_vccv=b_vccv,
    v=v_in, c=c_in, e=edge_features, Ex2=edge_index
  );
  v_act_list = append(v_act_list, t3);
  c_act_list = append(c_act_list, t4);
  v_out_list = append(v_out_list, t1);
  c_out_list = append(c_out_list, t2);
  v_in = t1;
  c_in = t2;
}

t = time();
v_act_list = list();
c_act_list = list();
v_out_list = list();
c_out_list = list();
v_in = variable_features;
c_in = constraint_features;
for(i in 1:10) {
  [v_act, c_act, v_out, c_out] = message_passing_bipartite(
    W_v=W_v_agg, W_c=W_c_agg, b_v=b_v, b_c=b_c,
    W_v_in=W_v_in, W_c_in=W_c_in,
    W_v_vccv=W_v_vccv, W_c_vccv=W_c_vccv, W_e_vccv=W_e_vccv, b_vccv=b_vccv,
    v=v_in, c=c_in, e=edge_features, Ex2=edge_index
  );
  v_act_list = append(v_act_list, v_act);
  c_act_list = append(c_act_list, c_act);
  v_out_list = append(v_out_list, v_out);
  c_out_list = append(c_out_list, c_out);
  v_in = v_out;
  c_in = c_out;
  print(v_out[1, 1]);
}
delta = (time() - t)/1000000;
print(delta + "ms");
